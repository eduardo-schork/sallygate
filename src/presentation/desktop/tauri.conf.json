{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sallygate",
  "identifier": "dev.sallygate.app",
  "build": {
    "beforeDevCommand": { "script": "bun run dev", "cwd": "../../.." },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "bun run build", "cwd": "../../.." },
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sallygate",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
